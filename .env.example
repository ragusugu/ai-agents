# AWS Credentials and Bedrock configuration for Desk
AWS_REGION=us-east-1
DESK_MODEL=us.moonshotai.kimi-k3.1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Optional
# AWS_SESSION_TOKEN=your_session_token_here
# DESK_PRICE_IN=0.50
# DESK_PRICE_OUT=2.00

# Local policy embeddings only; existing DESK_MODEL/AWS settings still handle answers.
DESK_EMBED_MODEL=BAAI/bge-small-en-v1.5
DESK_EMBED_CACHE_DIR=.desk/models
DESK_EMBED_THREADS=2
DESK_EMBED_BATCH_SIZE=8
DESK_EMBED_OFFLINE=0
DESK_RAG_DB_DIR=src/naive_rag/rag_db
DESK_RAG_TOP_K=4
